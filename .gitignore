# python: virtual environments and caches (rebuilt from pyproject.toml / uv.lock)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# javascript: downloaded libraries and build output (rebuilt from package.json)
node_modules/
dist/

# secrets: never commit these (.env.example IS committed)
.env
.env.*
!.env.example

# local data: personal, changes constantly
*.db
*.sqlite3
*.log
*.log.*
agent/logs/

# your own voice: speech test clips stay on this laptop only (Doc 09)
agent/tests/audio/clips/

# latex build leftovers (keep only .tex and .pdf)
*.aux
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# claude code: personal tooling (settings, activity log, agents) - not part of the project
.claude/

# ide and os clutter
.idea/
.vscode/
Thumbs.db
.DS_Store
