{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Listen command file",
  "description": "One YAML file in commands/ (spec §3.1). The agent checks each target and command on its own against $defs, skips invalid ones with a warning, and keeps the valid ones.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "targets": {
      "description": "Places Listen can send you: name -> a URL per verb, plus home.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/target"}
    },
    "defaults": {
      "description": "Verb -> the target used when the sentence names none (search: google).",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "aliases": {
      "description": "A short spoken name -> an app's name in the app index (chrome: Google Chrome).",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}}
  },
  "$defs": {
    "action": {
      "description": "The allowlist of primitives (spec §3.5): there is no 'run any program'.",
      "enum": ["open_url", "launch_app", "close_app", "set_volume", "change_volume",
               "toggle_mute", "press_keys", "focus_app"]
    },
    "target": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "pattern": {
      "description": "A sentence; each {slot} must be query, target, app or number (spec §3.2).",
      "type": "string",
      "pattern": "^(?:[^{}]|\\{(?:query|target|app|number)\\})+$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {"$ref": "#/$defs/action"},
        "params": {"type": "object"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "patterns"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}},
        "action": {"$ref": "#/$defs/action"},
        "params": {"type": "object"},
        "url_from": {"description": "Use the target's URL for this verb.", "type": "string", "minLength": 1},
        "steps": {"description": "A routine (spec §3.8).", "type": "array", "minItems": 1,
                  "items": {"$ref": "#/$defs/step"}},
        "when_app": {"type": "string", "minLength": 1},
        "focus_first": {"type": "boolean"},
        "risk": {"enum": ["low", "high"]},
        "continuous": {"enum": ["allow", "confirm", "block"]},
        "undo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keys"],
          "properties": {"keys": {"type": "string", "minLength": 1}}
        }
      },
      "oneOf": [{"required": ["action"]}, {"required": ["steps"]}],
      "allOf": [
        {
          "description": "press_keys only inside a named app (spec §3.5).",
          "if": {"required": ["action"], "properties": {"action": {"const": "press_keys"}}},
          "then": {"required": ["when_app"]}
        },
        {
          "if": {"required": ["steps"],
                 "properties": {"steps": {"contains": {"required": ["action"],
                                                       "properties": {"action": {"const": "press_keys"}}}}}},
          "then": {"required": ["when_app"]}
        }
      ]
    }
  }
}
